{
  "name": "supersocial",
  "version": "0.1.0",
  "private": true,
  "description": "Automation CLI pour LinkedIn (et plus tard X) via Playwright, stockage markdown local",
  "type": "module",
  "bin": {
    "supersocial": "./bin/supersocial.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chrome"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "gray-matter": "^4.0.3",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
